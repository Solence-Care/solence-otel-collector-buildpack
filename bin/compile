#!/bin/bash
BUILD_DIR=$1

# Version of otelcol-contrib to install. Set OTELCOL_VERSION in the app's
# environment (Terraform owns it, one value per environment) so an app never
# changes collector version on its own: a plain redeploy rebuilds the same
# version. The default below is only a safety net for an app that sets nothing.
OTELCOL_VERSION="${OTELCOL_VERSION:-v0.148.0}"
OTELCOL_VERSION_NUMBER="${OTELCOL_VERSION#v}"

echo "-----> Downloading OpenTelemetry Collector (contrib version) ${OTELCOL_VERSION}"
curl -fL -o otelcol-contrib.tar.gz "https://github.com/open-telemetry/opentelemetry-collector-releases/releases/download/${OTELCOL_VERSION}/otelcol-contrib_${OTELCOL_VERSION_NUMBER}_linux_amd64.tar.gz"
if [ $? -ne 0 ]; then
  echo "❌ Error: could not download otelcol-contrib ${OTELCOL_VERSION}."
  echo "   Check that OTELCOL_VERSION names an existing release (e.g. v0.161.0)."
  exit 1
fi

mkdir -p $BUILD_DIR/bin
tar -xzf otelcol-contrib.tar.gz -C $BUILD_DIR/bin

# Normalize binary name
if [ -f "$BUILD_DIR/bin/otelcol-contrib" ]; then
  mv $BUILD_DIR/bin/otelcol-contrib $BUILD_DIR/bin/otelcol
fi

chmod +x $BUILD_DIR/bin/otelcol

# 🔎 Check that opensearch exporter is available
if ! $BUILD_DIR/bin/otelcol components | grep -q "exporter/opensearch"; then
  echo "❌ Error: This otelcol build does not include the opensearch exporter."
  echo "   Make sure you are using otelcol-contrib, not otelcol core."
  exit 1
fi

echo "✅ otelcol (contrib) installed successfully with OpenSearch support"
echo "-----> Buildpack installation done"
